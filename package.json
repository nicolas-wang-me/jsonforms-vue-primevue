{
  "name": "@chaoqing/jsonforms-vue-primevue",
  "version": "3.8.6",
  "description": "Vue PrimeVue v4 renderers for JSON Forms — community-maintained fork of @jsonforms/vue-vuetify for the PrimeVue ecosystem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaoqing/jsonforms-vue-primevue.git"
  },
  "bugs": "https://github.com/chaoqing/jsonforms-vue-primevue/issues",
  "homepage": "https://github.com/chaoqing/jsonforms-vue-primevue#readme",
  "license": "MIT",
  "author": "chaoqing",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "vue",
    "primevue",
    "form",
    "forms",
    "json",
    "jsonforms",
    "frontend",
    "generator",
    "input",
    "renderengine",
    "jsonschema",
    "schema",
    "uischema",
    "layout",
    "customization"
  ],
  "main": "lib/jsonforms-vue-primevue.cjs.js",
  "module": "lib/jsonforms-vue-primevue.esm.js",
  "jsdelivr": "lib/jsonforms-vue-primevue.umd.js",
  "unpkg": "lib/jsonforms-vue-primevue.umd.js",
  "styles": "lib/jsonforms-vue-primevue.css",
  "typings": "lib/index.d.ts",
  "type": "module",
  "files": [
    "lib",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./lib/jsonforms-vue-primevue.esm.js",
      "require": "./lib/jsonforms-vue-primevue.cjs.js",
      "types": "./lib/index.d.ts"
    },
    "./lib/jsonforms-vue-primevue.css": "./lib/jsonforms-vue-primevue.css"
  },
  "scripts": {
    "dev": "vite --config vite.example.config.ts",
    "debug": "vite --config vite.example.config.ts --host 127.0.0.1 --port 5173",
    "debug:inspect": "node --inspect-brk ./node_modules/vite/bin/vite.js --config vite.example.config.ts",
    "debug:test": "vitest --ui --inspect-brk",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:examples-app": "run-p type-check \"build-only --config vite.example.config.ts {@}\" --",
    "clean": "rimraf lib example/dist",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "doc": "typedoc --tsconfig tsconfig.typedoc.json --name 'JSON Forms Vue PrimeVue Renderers' --out docs --entryPoints 'src/**/*.ts' 'lib/index.d.ts'",
    "test": "vitest --watch=false",
    "test-cov": "vitest --watch=false --coverage",
    "build-only": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" vite build",
    "type-check": "vue-tsc -p tsconfig.lib.json --noEmit"
  },
  "peerDependencies": {
    "@jsonforms/core": "3.7.0",
    "@jsonforms/vue": "3.7.0",
    "ajv": "^8.6.1",
    "dayjs": "^1.10.6",
    "lodash": "^4.17.21",
    "maska": "^2.1.11",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@jsonforms/core": "^3.7.0",
    "@jsonforms/examples": "^3.7.0",
    "@jsonforms/vue": "^3.7.0",
    "@mdi/font": "^7.4.47",
    "@rushstack/eslint-patch": "^1.8.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/jsdom": "^21.1.6",
    "@types/lodash": "^4.14.172",
    "@types/node": "^22.13.8",
    "@types/splitpanes": "^2.2.6",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^1.6.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.5",
    "@vue/tsconfig": "^0.5.1",
    "ajv": "^8.6.1",
    "ajv-keywords": "^5.1.0",
    "core-js": "^3.9.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.10.6",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "eslint-plugin-vue-scoped-css": "^2.8.0",
    "jsdom": "^27.2.0",
    "json-refs": "3.0.15",
    "lodash": "^4.17.21",
    "maska": "^2.1.11",
    "monaco-editor": "^0.49.0",
    "npm-run-all2": "^6.1.2",
    "playwright": "^1.60.0",
    "prettier": "^3.2.5",
    "resize-observer-polyfill": "^1.5.1",
    "rimraf": "^6.1.0",
    "rollup-plugin-postcss": "^4.0.2",
    "sass-embedded": "^1.99.0",
    "splitpanes": "^3.1.5",
    "typedoc": "~0.25.3",
    "typescript": "~5.5.0",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^3.9.1",
    "vite-plugin-node-polyfills": "^0.21.0",
    "vite-plugin-static-copy": "^2.3.2",
    "vitest": "^1.4.0",
    "vue": "^3.5.17",
    "vue-eslint-parser": "^9.4.2",
    "vue-tsc": "^2.0.11"
  },
  "dependencies": {
    "@primevue/themes": "^4.5.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5"
  }
}
